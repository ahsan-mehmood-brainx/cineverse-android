<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Bottom navigation: filled/outline icon swap on selection, primary-tinted labels/icons,
         and a pill-shaped selection background that spans both the icon and the label. -->
    <style name="Widget.CineVerse.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CineVerse.BottomNavigationView.ActiveIndicator</item>
        <item name="itemBackground">@drawable/bottom_nav_item_background</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Material's built-in indicator only wraps the icon; it's disabled here in favor of
         itemBackground above, which covers the whole item (icon + label). -->
    <style name="Widget.CineVerse.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Rounds only the top corners of a movie poster so they align with the card's
         corner radius while the bottom edge stays flush with the title text below it. -->
    <style name="ShapeAppearanceOverlay.CineVerse.MovieCard" parent="">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
